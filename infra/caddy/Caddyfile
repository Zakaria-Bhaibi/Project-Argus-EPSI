{
	admin off
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

:8443 {
	# certificate issued by the ARGUS private CA (infra/pki/pki.sh server outpost ...)
	tls /certs/outpost.crt /certs/outpost.key {
		protocols tls1.2 tls1.3
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self' wss:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
		-Server
	}

	request_body {
		max_size 64KB
	}

	handle /api/* {
		reverse_proxy api:8000
	}

	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}
}
