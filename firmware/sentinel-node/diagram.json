{
  "version": 1,
  "author": "Project Argus",
  "editor": "wokwi",
  "parts": [
    { "type": "board-esp32-devkit-c-v4", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": -150, "left": -140, "attrs": { "temperature": "23", "humidity": "45" } },
    { "type": "wokwi-gas-sensor", "id": "gas", "top": -160, "left": 40, "attrs": { "ppm": "180" } },
    { "type": "wokwi-pir-motion-sensor", "id": "pir", "top": -150, "left": 230, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled", "top": 150, "left": 230, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-buzzer", "id": "bz", "top": 40, "left": 330, "attrs": { "volume": "0.1" } },
    { "type": "wokwi-pushbutton", "id": "tamper", "top": 230, "left": -130, "attrs": { "color": "red", "label": "TAMPER" } },
    { "type": "wokwi-led", "id": "ledG", "top": 40, "left": 180, "attrs": { "color": "green" } },
    { "type": "wokwi-led", "id": "ledO", "top": 40, "left": 210, "attrs": { "color": "orange" } },
    { "type": "wokwi-led", "id": "ledR", "top": 40, "left": 240, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "rG", "top": 110, "left": 170, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rO", "top": 110, "left": 200, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-resistor", "id": "rR", "top": 110, "left": 230, "rotate": 90, "attrs": { "value": "220" } }
  ],
  "connections": [
    [ "esp:TX", "$serialMonitor:RX", "", [] ],
    [ "esp:RX", "$serialMonitor:TX", "", [] ],

    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:15", "green", [] ],

    [ "gas:VCC", "esp:3V3", "red", [] ],
    [ "gas:GND", "esp:GND.1", "black", [] ],
    [ "gas:AO", "esp:34", "orange", [] ],

    [ "pir:VCC", "esp:5V", "red", [] ],
    [ "pir:GND", "esp:GND.2", "black", [] ],
    [ "pir:OUT", "esp:27", "violet", [] ],

    [ "oled:VCC", "esp:3V3", "red", [] ],
    [ "oled:GND", "esp:GND.2", "black", [] ],
    [ "oled:SDA", "esp:21", "blue", [] ],
    [ "oled:SCL", "esp:22", "yellow", [] ],

    [ "bz:1", "esp:GND.2", "black", [] ],
    [ "bz:2", "esp:25", "magenta", [] ],

    [ "tamper:1.l", "esp:4", "red", [] ],
    [ "tamper:2.l", "esp:GND.1", "black", [] ],

    [ "esp:18", "rG:2", "green", [] ],
    [ "rG:1", "ledG:A", "green", [] ],
    [ "ledG:C", "esp:GND.2", "black", [] ],
    [ "esp:19", "rO:2", "orange", [] ],
    [ "rO:1", "ledO:A", "orange", [] ],
    [ "ledO:C", "esp:GND.2", "black", [] ],
    [ "esp:23", "rR:2", "red", [] ],
    [ "rR:1", "ledR:A", "red", [] ],
    [ "ledR:C", "esp:GND.2", "black", [] ]
  ],
  "dependencies": {}
}
